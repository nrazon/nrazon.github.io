  {
   "tarih": "2026-11-10",
   "baslik": "Saturn Behind the Moon",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-10-saturn-behind-the-moon/",
   "ozet_en": "Explanation: Sometimes Saturn disappears. It doesn't really go away, of course -- it just disappears from our view when Earth's Moon moves in front.",
   "kredi": "Roberto Ortu",
   "nasa_kaynakli": false
  },
  {
   "tarih": "2026-11-09",
   "baslik": "Rigel and the Witch Head Nebula",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-9-rigel-and-the-witch-head-nebula/",
   "ozet_en": "Explanation: Does the blue nebula look like the head of a witch? The nebula is known popularly as the Witch Head Nebula because, it is said, the nebula's shape resembles a Halloween-style caricature of a witch's head. Exactly how, though, can be a topic of imaginative speculation.",
   "kredi": "Piotr Czerski",
   "nasa_kaynakli": false
  },
  {
   "tarih": "2026-11-08",
   "baslik": "Major Fireball Meteor",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-8-major-fireball-meteor/",
   "ozet_en": "Explanation: The sky glows with soft pinkish colors of fading twilight in this serendipitous mountaintop vista. Taken in subfreezing temperatures, the thoughtfully composed photo shows snowy, rugged peaks seen from a mountain pass on 2017 November 14.",
   "kredi": "Ollie Taylor",
   "nasa_kaynakli": false
  },
  {
   "tarih": "2026-11-07",
   "baslik": "De Gerlache-Kocher Massif",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-7-de-gerlache-kocher-massif/",
   "ozet_en": "Explanation: De Gerlache-Kocher massif looms on the visible horizon in this close-up of the edge of the Moon. The mountainous formation rises about 4 kilometers above its surroundings and is located very close to the lunar south pole.",
   "kredi": "Alejandro Sanz",
   "nasa_kaynakli": false
  },
  {
   "tarih": "2026-11-06",
   "baslik": "A Farewell to Swift",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-6-a-farewell-to-swift/",
   "ozet_en": "Explanation: It is time to say goodbye to NASA's Neil Gehrels Swift Observatory. After nearly 22 years of service, the satellite re-entered Earth's atmosphere on November 4 at 7:39 EST over the North Sumatra region of Indonesia.",
   "kredi": "NASA/Swift and AndreaMosaic",
   "nasa_kaynakli": false
  },
  {
   "tarih": "2026-11-05",
   "baslik": "Enceladus in Silhouette",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-5-enceladus-in-silhouette/",
   "ozet_en": "Explanation: One of our Solar System's most tantalizing worlds, Enceladus is backlit by the Sun in this Cassini spacecraft image from November 1, 2009. The dramatic illumination reveals the plumes that continuously spew into space from the south pole of Saturn's 500 kilometer diameter moon.",
   "kredi": "Cassini Imaging Team, SSI, JPL, ESA, NASA",
   "nasa_kaynakli": false
  },
  {
   "tarih": "2026-11-04",
   "baslik": "The Not-So-Hidden Galaxy, IC 342",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-4-the-not-so-hidden-galaxy-ic-342/",
   "ozet_en": "Explanation: “I see” IC 342, the Hidden Galaxy! Today’s image peers through the plane of the Milky Way, through all its gas, dust and stars, to unveil this spiral galaxy. IC 342 (or Caldwell 5) is one of the brightest members of the IC 342/Maffei group of galaxies.",
   "kredi": "Artem Mironov",
   "nasa_kaynakli": false
  },
  {
   "tarih": "2026-11-03",
   "baslik": "Comet PanSTARRs and Rainbow Meteor",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-3-comet-panstarrs-and-rainbow-meteor/",
   "ozet_en": "Explanation: Did this meteor come from that comet? Probably not. Although many meteors do originate from comets, there are thousands of comets that have visited the inner Solar System recently, and matching meteors to them can be tricky. And to be clear, the pictured comet is far behind the streaking meteor.",
   "kredi": "Eddy Metais",
   "nasa_kaynakli": false
  },
  {
   "tarih": "2026-11-02",
   "baslik": "A Long Cloud on Mars",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-2-a-long-cloud-on-mars/",
   "ozet_en": "Explanation: What’s causing this unusually long cloud on Mars? Known as the Arsia Mons Elongated Cloud (AMEC) and first recorded by NASA’s Viking Orbiter 2 in 1977, the strange cloud has been imaged in greater detail more recently by ESA’s robotic Mars Express spacecraft. The featured image is from 2018.",
   "kredi": "ESA, DLR, FU Berlin; Processing &amp; License: J. Cowart",
   "nasa_kaynakli": false
  },
  {
   "tarih": "2026-11-01",
   "baslik": "Colors of the Moon",
   "tur": "image",
   "baglanti": "https://science.nasa.gov/image-article/apod-2026-november-1-colors-of-the-moon/",
   "ozet_en": "Explanation: What color is the Moon? It depends on the night -- and the time. Outside of the Earth's atmosphere, the dark Moon, which shines by reflected sunlight, appears a magnificently brown-tinged gray.",
   "kredi": "Marcella Giulia Pace",
   "nasa_kaynakli": false
  }
